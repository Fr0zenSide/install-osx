#########################
# .gitignore file for OS X System
#########################

# Mac Os X
.DS_Store

# Emacs temporary files
*~
# Emacs un-save files
\#*\#

# ignore thefuck alias folder it's created when thefuck is installed
dotfiles/.config/thefuck

# ignore tmux plugins folder > ($TMUX_PLUGIN_MANAGER_PATH)
dotfiles/.config/tmux/plugins/

# ignore tmp folder to process stuff like colorls of dracula
tmp/dotfiles/.config/shikki/keys/*.p8
dotfiles/.config/shikki/.env

# Runtime log noise (one-K shiki refs are historical)
*.log
**/daemon.log
**/approval.log
**/operations.log

# ── machine-state & secrets guard (2026-07-11, public repo) ──
dotfiles/.config/.android/
dotfiles/.config/atuin/*
!dotfiles/.config/atuin/config.toml
dotfiles/.config/caddy/autosave.json
dotfiles/.config/colima/
dotfiles/.config/configstore/
dotfiles/.config/emacs/elpa/
dotfiles/.config/filezilla/
dotfiles/.config/gh/
dotfiles/.config/shikki/keys/
dotfiles/.config/shikki/restic-passphrase*
dotfiles/.config/shikki/nats-server.*
dotfiles/.config/shikki/test-cache/
dotfiles/.config/shikki/tmux-state.json
dotfiles/.config/shikki/last-session
dotfiles/.config/woodpecker-agent/
dotfiles/.config/zed/prompts/
tmp/
\#*\#
